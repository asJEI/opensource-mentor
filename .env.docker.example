# 复制此文件为 .env 并填入真实值
# cp .env.example .env

# ---------- 通用配置 ----------
# 是否使用 Mock 数据（开发/演示用）
VITE_USE_MOCK=true

# ---------- GitHub 配置 ----------
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TOKEN=
VITE_GITHUB_TOKEN=

# ---------- LLM 配置 ----------
LLM_PROVIDER=deepseek
LLM_API_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60000

VITE_LLM_API_KEY=
VITE_LLM_MODEL=deepseek-chat
