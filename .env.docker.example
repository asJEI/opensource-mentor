# Docker Compose / VPS fallback only.
# Copy to `.env` next to docker-compose.yml when using Legacy deploy.
# Cloudflare Workers do not use this file — use `.dev.vars` / Wrangler Secrets.

# ---------- Platform (server container) ----------
GITHUB_API_BASE_URL=https://api.github.com
PLATFORM_GITHUB_TOKEN=
PLATFORM_LLM_API_KEY=
DEFAULT_LLM_PROVIDER=deepseek
DEFAULT_LLM_BASE_URL=https://api.deepseek.com
DEFAULT_LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_MS=60000

# Legacy aliases accepted by server/src/config:
# GITHUB_TOKEN=
# LLM_API_KEY=
# LLM_PROVIDER=
# LLM_API_BASE_URL=
# LLM_MODEL=
# LLM_TIMEOUT=

# User BYOK / browser secrets must NOT be set as VITE_* variables.
