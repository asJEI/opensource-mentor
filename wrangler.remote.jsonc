{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "opensource-mentor-remote-mvp",
  "main": "worker/remote/index.mjs",
  "compatibility_date": "2026-08-14",
  "workers_dev": true,
  "vars": {
    "WEBSITE_ORIGIN": "https://hokkai.top",
    "REMOTE_ORIGIN": "https://opensource-mentor-remote-mvp.316920080dd.workers.dev",
    "REMOTE_OAUTH_REQUIRE_LOGIN": "true"
  },
  "durable_objects": { "bindings": [{ "name": "REMOTE_USERS", "class_name": "RemoteUserState" }, { "name": "REMOTE_OAUTH", "class_name": "RemoteOAuthState" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RemoteUserState"] }, { "tag": "v2", "new_sqlite_classes": ["RemoteOAuthState"] }],
  "ratelimits": [{ "name": "REMOTE_RATE_LIMITER", "namespace_id": "2101", "simple": { "limit": 40, "period": 60 } }],
  "observability": { "enabled": false }
  // OAuth needs no manually issued tokens or new secrets. Legacy personal tokens remain optional.
  // This config has no custom-domain route and does not modify the existing website Worker.
}
