# Legacy Express / Docker platform config (VPS fallback).
# Copy to server/.env — never commit real secrets.
#
# Preferred names (Cloudflare-aligned):
PLATFORM_GITHUB_TOKEN=
PLATFORM_LLM_API_KEY=
DEFAULT_LLM_PROVIDER=deepseek
DEFAULT_LLM_MODEL=deepseek-v4-flash
DEFAULT_LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_MS=60000
GITHUB_API_BASE_URL=https://api.github.com

# Express-only (not used by Cloudflare Workers):
PORT=3001
NODE_ENV=development

# Legacy aliases still accepted by server/src/config (prefer PLATFORM_* / DEFAULT_* above):
# GITHUB_TOKEN=
# LLM_PROVIDER=
# LLM_API_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# LLM_TIMEOUT=

# User BYOK (provider / apiKey / model / baseUrl / githubToken):
# - Do NOT put user keys in this file
# - Browser localStorage → per-request headers/body only
