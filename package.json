{
  "name": "opensource-mentor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --include-runtime false",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "typecheck:server": "npm --prefix server run typecheck",
    "test": "vitest run --config vitest.config.ts",
    "mcp:install": "npm --prefix packages/mentor-mcp ci",
    "mcp:start": "node packages/mentor-mcp/src/stdio.mjs",
    "test:mcp": "npm --prefix packages/mentor-mcp test",
    "remote:dev": "wrangler dev --config wrangler.remote.jsonc --var REMOTE_ORIGIN:http://localhost:8787",
    "remote:build": "wrangler deploy --config wrangler.remote.jsonc --dry-run --outdir .remote-mcp-build"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@cloudflare/workers-types": "^5.20260816.1",
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "axios": "^1.18.1",
    "clsx": "^2.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "zod": "4.6.5",
    "zustand": "^5.0.14"
  }
}
